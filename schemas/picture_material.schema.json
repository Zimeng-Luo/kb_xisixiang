{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-engineer.local/schemas/picture_material.schema.json",
  "title": "Picture Material",
  "description": "Schema for JSON files under data/knowledge_base/materials/pictures/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "revision", "status", "updated_at",
    "picture_id",
    "title",
    "link",
    "description",
    "application"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "picture_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "title": {
      "$ref": "#/$defs/non_empty_string"
    },
    "link": {
      "$ref": "#/$defs/non_empty_string"
    },
    "description": {
      "$ref": "#/$defs/non_empty_string"
    },
    "application": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}