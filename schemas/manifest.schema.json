{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-engineer.local/schemas/manifest.schema.json",
  "title": "Knowledge Base Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "snapshot_id",
    "schema_version",
    "source_revision",
    "status",
    "indexes"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": ["draft", "reviewed", "published", "deprecated"]
    },
    "indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "built_from_revision",
        "source_fingerprint",
        "built_at"
      ],
      "properties": {
        "status": {
          "enum": ["current", "stale", "building"]
        },
        "built_from_revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "built_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}